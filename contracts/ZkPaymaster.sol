pragma solidity 0.8.28;

import {HegotaSupport, Devnet, Scope, TxParam} from "@forshtat/hegota-support/contracts/HegotaSupport.sol";
import {IStakingRegistry} from "./interfaces/IStakingRegistry.sol";

/// Groth16 verifier generated by snarkjs from circuits/Membership.circom.
/// Kept as a separate stateless contract so the paymaster bytecode stays below
/// the EIP-170 limit and the verification key can be rotated by deploying a
/// new verifier + paymaster.
interface IGroth16Verifier {
    function verifyProof(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256[7] calldata publicInputs
    ) external view returns (bool);
}

/// ZK membership paymaster.
///
/// The paymaster learns only:
///   - the transaction sender (a rotating session key),
///   - the nullifier for (secret, epoch),
///   - the public root/epoch/paymaster/chainId/sessionKey/nullifier statement.
///
/// It never learns which leaf in the authorized set the sender owns. The company
/// admin maintains the Poseidon Merkle root on-chain. One nullifier is burned
/// per successful charge, giving one sponsored transaction per credential per
/// epoch.
contract ZkPaymaster is HegotaSupport(Devnet.ERC8421_WORKSHOP) {
    address public admin;
    address public treasury;
    address public immutable registry;
    address public immutable verifier;

    /// Poseidon Merkle root of the authorized-set leaves.
    uint256 public root;
    /// Admin-controlled epoch. Incrementing it invalidates outstanding proofs.
    uint256 public epoch;
    /// Maximum transaction cost this sponsor will cover, in wei.
    uint256 public maxSponsorCost;
    uint256 public redeemedCount;

    mapping(uint256 => bool) public usedNullifier;
    mapping(bytes32 => bool) public chargedTx;

    uint256 public pendingWithdrawals;
    uint64 public withdrawalDelay;
    uint256 public withdrawalAmount;
    uint64 public withdrawalUnlockAt;
    bool private _entered;

    event RootSet(uint256 root);
    event EpochSet(uint256 epoch);
    event MaxSponsorCostSet(uint256 maxCost);
    event WithdrawalDelaySet(uint64 delay);
    event Redeemed(uint256 indexed nullifier, address indexed sessionKey, uint256 maxCost);
    event Charged(bytes32 indexed sigHash, uint256 indexed nullifier);
    event Deposited(address indexed from, uint256 amount);
    event WithdrawalRequested(uint256 amount, uint64 unlockAt);
    event WithdrawalExecuted(uint256 amount);
    event WithdrawalCancelled(uint256 amount);

    modifier onlyAdmin() {
        require(msg.sender == admin, "not admin");
        _;
    }

    modifier nonReentrant() {
        require(!_entered, "reentrant");
        _entered = true;
        _;
        _entered = false;
    }

    constructor(
        address admin_,
        address treasury_,
        address registry_,
        address verifier_,
        uint256 maxSponsorCost_,
        uint256 root_
    ) payable {
        require(admin_ != address(0), "admin=0");
        require(treasury_ != address(0), "treasury=0");
        require(registry_ != address(0), "registry=0");
        require(verifier_ != address(0), "verifier=0");
        require(maxSponsorCost_ > 0, "maxCost=0");
        require(root_ != 0, "root=0");
        admin = admin_;
        treasury = treasury_;
        registry = registry_;
        verifier = verifier_;
        maxSponsorCost = maxSponsorCost_;
        root = root_;
    }

    // ------------------------------------------------------------------ admin --

    function setRoot(uint256 root_) external onlyAdmin {
        require(root_ != 0, "root=0");
        root = root_;
        emit RootSet(root_);
    }

    function setEpoch(uint256 epoch_) external onlyAdmin {
        epoch = epoch_;
        emit EpochSet(epoch_);
    }

    function setMaxSponsorCost(uint256 maxCost_) external onlyAdmin {
        require(maxCost_ > 0, "maxCost=0");
        maxSponsorCost = maxCost_;
        emit MaxSponsorCostSet(maxCost_);
    }

    function setWithdrawalDelay(uint64 delay) external onlyAdmin {
        withdrawalDelay = delay;
        emit WithdrawalDelaySet(delay);
    }

    // ------------------------------------------------- funding / withdrawals --

    function deposit() external payable {
        emit Deposited(msg.sender, msg.value);
    }

    function stake(uint32 unstakeDelaySec) external payable onlyAdmin {
        IStakingRegistry(registry).addStake{value: msg.value}(unstakeDelaySec);
    }

    function requestWithdrawal(uint256 amount) external onlyAdmin {
        require(amount > 0, "amount=0");
        require(withdrawalAmount == 0, "pending request");
        require(address(this).balance >= pendingWithdrawals + amount, "insufficient");
        withdrawalAmount = amount;
        withdrawalUnlockAt = uint64(block.timestamp) + withdrawalDelay;
        pendingWithdrawals += amount;
        emit WithdrawalRequested(amount, withdrawalUnlockAt);
    }

    function executeWithdrawal() external onlyAdmin nonReentrant {
        uint256 amount = withdrawalAmount;
        require(amount > 0, "no request");
        require(block.timestamp >= withdrawalUnlockAt, "not unlocked");
        require(address(this).balance >= amount, "insufficient balance");
        withdrawalAmount = 0;
        withdrawalUnlockAt = 0;
        pendingWithdrawals -= amount;
        (bool ok, ) = treasury.call{value: amount}("");
        require(ok, "withdraw failed");
        emit WithdrawalExecuted(amount);
    }

    function cancelWithdrawal() external onlyAdmin {
        uint256 amount = withdrawalAmount;
        require(amount > 0, "no request");
        withdrawalAmount = 0;
        withdrawalUnlockAt = 0;
        pendingWithdrawals -= amount;
        emit WithdrawalCancelled(amount);
    }

    // ------------------------------------------------------- EIP-8141 frames --

    /// `pre_verify` (DEFAULT) frame.
    ///
    /// Public inputs, in the circuit's order:
    ///   [root, epoch, paymaster, chainId, sessionKey,
    ///    identityNullifier, sessionNullifier]
    ///
    /// `identityNullifier` is burned; `sessionNullifier` is the public binding
    /// value that forces the proof to be for TXPARAM.SENDER. The transaction
    /// signature covers the frame data containing this proof, so the proof is
    /// bound to this tx without also committing to SIG_HASH.
    function charge(
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c,
        uint256 identityNullifier,
        uint256 sessionNullifier
    ) external {
        require(msg.sender == address(0xaa), "not entrypoint");
        require(!usedNullifier[identityNullifier], "already spent");

        address sessionKey = address(uint160(txparam(TxParam.SENDER)));

        // Enforce the sponsor's cost ceiling against the transaction's actual
        // maximum cost. Without this, a valid credential can make the paymaster
        // escrow/pay far more than maxSponsorCost.
        uint256 maxCost = txparam(TxParam.MAX_COST);
        require(maxCost <= maxSponsorCost, "max cost");
        require(
            address(this).balance >= maxCost + pendingWithdrawals,
            "insolvent"
        );

        uint256[7] memory publicInputs = [
            root,
            epoch,
            uint256(uint160(address(this))),
            block.chainid,
            uint256(uint160(sessionKey)),
            identityNullifier,
            sessionNullifier
        ];
        require(
            IGroth16Verifier(verifier).verifyProof(a, b, c, publicInputs),
            "bad proof"
        );

        bytes32 sigHash = bytes32(txparam(TxParam.SIG_HASH));
        require(!chargedTx[sigHash], "already charged");

        usedNullifier[identityNullifier] = true;
        chargedTx[sigHash] = true;
        redeemedCount += 1;

        emit Redeemed(identityNullifier, sessionKey, maxCost);
        emit Charged(sigHash, identityNullifier);
    }

    /// Pay frame (empty calldata): approve only after this tx's charge.
    fallback() external payable {
        require(msg.sender == address(0xaa), "not entrypoint");
        require(chargedTx[bytes32(txparam(TxParam.SIG_HASH))], "not charged");
        approve(Scope.PAYMENT);
    }
}
