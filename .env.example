# EIP-8141 devnet
NEXT_PUBLIC_CHAIN_ID=1337
NEXT_PUBLIC_RPC_URL=https://altmempool.forshtat.com/rpc
NEXT_PUBLIC_GATEWAY_URL=https://altmempool.forshtat.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.altmempool.wtf

# Deploy CompanyFactory and paste its address to enable live admin writes.
NEXT_PUBLIC_FACTORY_ADDRESS=
# Optional: prefill the paymaster address in the admin/pay pages.
NEXT_PUBLIC_DEFAULT_PAYMASTER=
NEXT_PUBLIC_STAKING_REGISTRY=0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f

# Set to "true" to broadcast sponsored frame transactions from /pay.
NEXT_PUBLIC_ENABLE_SUBMIT=false

# WalletConnect projectId for the multi-wallet "Connect wallet" button
# (admin flows). Get one at https://cloud.walletconnect.com. Without it,
# injected wallets (MetaMask/Coinbase/Rainbow) still work; WalletConnect
# (mobile / QR) is hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# anon-rpc is the default RPC transport. The value below is the passthrough
# worker (sandboxed, but NOT anonymous). For real privacy set this to an
# adopter specifier from https://ethereum.github.io/anon-rpc/adopters/.
NEXT_PUBLIC_ANON_RPC_SPECIFIER=0x4fd77be300f31c5fe6ab266d35d27750a3478d27
# Mainnet RPC used once to read the specifier contract (not anonymized).
NEXT_PUBLIC_ANON_RPC_BOOTSTRAP_RPC=https://ethereum-rpc.publicnode.com
