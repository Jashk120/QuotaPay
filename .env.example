# EIP-8141 devnet
NEXT_PUBLIC_CHAIN_ID=1337
# Public alt-mempool: default 100k validation cap and no BN254 precompiles.
NEXT_PUBLIC_RPC_URL=https://altmempool.forshtat.com/rpc
NEXT_PUBLIC_GATEWAY_URL=https://altmempool.forshtat.com
# Self-hosted sidecar: ~500k validation budget and BN254 precompiles, required
# for the ZK vote/sponsorship path. Use these values instead of the public ones.
#NEXT_PUBLIC_RPC_URL=https://sidecar.161.118.164.226.nip.io/rpc
#NEXT_PUBLIC_GATEWAY_URL=https://sidecar.161.118.164.226.nip.io
NEXT_PUBLIC_EXPLORER_URL=https://explorer.altmempool.wtf

# Deploy CompanyFactory and paste its address to enable live admin writes.
NEXT_PUBLIC_FACTORY_ADDRESS=
# Optional: prefill the paymaster address in the admin/pay pages.
NEXT_PUBLIC_DEFAULT_PAYMASTER=
NEXT_PUBLIC_STAKING_REGISTRY=0xd51c04d7a0b01124e84de152f4e56d9eecb22d2f

# Set to "true" to broadcast sponsored frame transactions from /pay.
NEXT_PUBLIC_ENABLE_SUBMIT=false

# WalletConnect projectId for the multi-wallet "Connect wallet" button
# (admin flows). Get one at https://cloud.walletconnect.com. Without it,
# injected wallets (MetaMask/Coinbase/Rainbow) still work; WalletConnect
# (mobile / QR) is hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# anon-rpc is the default RPC transport. The value below is the passthrough
# worker (sandboxed, but NOT anonymous). For real privacy set this to an
# adopter specifier from https://ethereum.github.io/anon-rpc/adopters/.
NEXT_PUBLIC_ANON_RPC_SPECIFIER=0x4fd77be300f31c5fe6ab266d35d27750a3478d27
# Mainnet RPC used once to read the specifier contract (not anonymized).
NEXT_PUBLIC_ANON_RPC_BOOTSTRAP_RPC=https://ethereum-rpc.publicnode.com

# DAO operator LLM (server-only; never NEXT_PUBLIC_). All three are
# OpenAI-compatible POST {base}/chat/completions. Pick one:
#   LLM_PROVIDER=openai | openrouter | custom
# If unset, auto-detects: OPENROUTER_API_KEY > OPENAI_API_KEY > custom base+key.
# With nothing set the UI uses the deterministic local parser.
#LLM_PROVIDER=
# OpenAI
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
# OpenRouter (also serves cheap Chinese models: deepseek, qwen, kimi, minimax)
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=deepseek/deepseek-chat
#OPENROUTER_SITE_URL=http://localhost:3000
#OPENROUTER_APP_NAME=QuotaPay DAO operator
# OpenCode Go subscription gateway (OpenAI-compatible, cheap Chinese models).
# Key only: base defaults to https://opencode.ai/inference/go/openai/v1,
# model defaults to deepseek-v4.1-flash. Override either if needed.
#OPENCODE_GO_API_KEY=
#OPENCODE_GO_MODEL=deepseek-v4.1-flash
#OPENCODE_GO_API_URL=https://opencode.ai/inference/go/openai/v1
# Optional stable session id (generated per process if unset).
#OPENCODE_GO_SESSION=ses_quotaPay1
# Generic OpenAI-compatible gateway (SiliconFlow, Ollama, etc.).
#LLM_BASE_URL=http://localhost:8080/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-chat

# Cloud agent (Neon Postgres shared by Next.js API + VPS worker).
#DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Test mode: no wallet signature required, simulated execution.
# Turn off (false) to require EIP-191 signatures on intents.
#AGENT_TEST_MODE=true
#NEXT_PUBLIC_AGENT_TEST_MODE=true
# Worker knobs (VPS process: npm run agent:worker).
#WORKER_POLL_MS=3000
# Keep false until real submission lands; worker only records, never sends.
#EXECUTE_ONCHAIN=false

# ---- DAO operator: on-chain mode ----------------------------------------
# Set to the deployed DaoCore address. Every member, cap, proposal, asset,
# balance, policy rule and event is read from the chain. There is no local or
# simulated DAO state.
#NEXT_PUBLIC_DAO_CORE=
# Optional display name. The chain only stores the daoId.
#NEXT_PUBLIC_DAO_NAME=
# ERC-20 used for treasury balance and caps. Leave empty to use native ETH.
#NEXT_PUBLIC_USDC_ADDRESS=
#NEXT_PUBLIC_USDC_DECIMALS=6
# How often the console re-reads the chain, in ms.
#NEXT_PUBLIC_DAO_REFRESH_MS=15000
# DaoFactory used by /new to deploy a real DAO (createDao).
#NEXT_PUBLIC_DAO_FACTORY=
# Optional Chainlink USDC/USD aggregator. Display only; caps never use it.
#NEXT_PUBLIC_CHAINLINK_USDC_USD=
# Optional Uniswap v4 StateView + pool id for a spot read. Display only.
#NEXT_PUBLIC_DAO_STATE_VIEW=
#NEXT_PUBLIC_DAO_POOL_ID=
# Optional v4 treasury funding: helper that swaps ETH -> USDC and sends the
# output to the DAO. Run scripts/seed-usdc-pool.mjs to deploy it and seed the
# ETH/USDC pool.
#NEXT_PUBLIC_TREASURY_FUND_HELPER=
#NEXT_PUBLIC_USDC_POOL_FEE=3000
#NEXT_PUBLIC_USDC_POOL_TICK_SPACING=60
#NEXT_PUBLIC_USDC_POOL_HOOKS=0x0000000000000000000000000000000000000000

# Server-only execution (never NEXT_PUBLIC_). /api/dao/execute builds and
# signs an EIP-8141 frame transaction with this key; it must match
# AgentAccount.agentSigner().
#DAO_AGENT_KEY=
# Gas paymaster that sponsors the frame transaction.
#NEXT_PUBLIC_DAO_GAS_PAYMASTER=
# Server overrides (fall back to the NEXT_PUBLIC_ values above).
#DAO_CORE=
#DAO_GAS_PAYMASTER=
#DAO_RPC_URL=
#DAO_CHAIN_ID=1337
