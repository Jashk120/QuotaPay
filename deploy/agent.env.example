# VPS ~/agent/.env — copy, fill, chmod 600. Never commit the real one.
# Least-privilege Neon role for the worker (SELECT/UPDATE agent_intents,
# INSERT agent_events). Falls back to DATABASE_URL when unset.
WORKER_DATABASE_URL=postgresql://worker:CHANGE_ME@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://owner:CHANGE_ME@ep-xxx.neon.tech/db?sslmode=require
# Test mode: no wallet signature required. Set false to require EIP-191 intents.
AGENT_TEST_MODE=true
WORKER_POLL_MS=3000
# Keep false until real submission lands; worker records, never sends.
EXECUTE_ONCHAIN=false
# Future: agent EOA key for frame-tx submission (KMS/manual, never in image).
# AGENT_SIGNER_KEY=
